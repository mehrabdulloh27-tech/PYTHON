class Car:
    def __init__(self,brend,color):
        self.brend=brend
        self.color=color
class BMW(Car):
    def __init__(self,model,brend,color):
        self.model=model
        super().__init__(brend,color)
    def show(self):
        print("Model:",self.model)
        print("Brend:",self.brend)
        print("Color:",self.color)
mashina=BMW("Toyota","Land Cruiser","Qora")
mashina.show()

