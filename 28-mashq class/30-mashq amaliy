class Animal:
    def __init__(self,name):
        self.name=name
    def show(self):
        print("Laqabi:",self.name)
class Dog(Animal):
    def __init__(self,name,breed):
        self.breed=breed
        super().__init__(name)
    def show_dog(self):
        super().show()
        print("Zoti:",self.breed)
dog=Dog("Simba","Abcharka")
dog.show_dog()
