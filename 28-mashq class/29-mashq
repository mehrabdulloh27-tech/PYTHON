class Kutubxona:
    def __init__(self, nomi):
        self.nomi = nomi
        self.kitoblar = []
        self.kitoblar_soni = 0

    def add_book(self, *kitob):
        self.kitoblar.extend(kitob)
        self.kitoblar_soni += len(kitob)

    def remove_book(self, kitob):
        self.kitoblar.remove(kitob)
        self.kitoblar_soni -= 1


