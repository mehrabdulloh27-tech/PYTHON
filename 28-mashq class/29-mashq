class Fan:
    def __init__(self,nomi):
        self.nomi=nomi
        self.talabalar_soni=0
        self.talabalar=[]
    def add_student(self,talaba):
        self.talabalar.append(talaba)
        self.talabalar_soni+=1
    def get_students(self):
        return [talaba.get_info() for talaba in self.talabalar]
